# Local Windows/backend configuration. Never use VITE_ for secrets.
PORT=5000
JC_HOST=127.0.0.1
JC_ALLOWED_ORIGINS=https://jcevnzl.space,https://www.jcevnzl.space
JC_SECURE_COOKIE=1
JC_TIMEZONE=America/Caracas
JC_DATA_DIR=C:/ProgramData/JCEnterprise/data
# Stop the existing server, then run npm run migrate:data before updating.
# Existing database.json is imported only from the private data directory.
# For a completely NEW installation only:
# JC_ADMIN_EMAIL=admin@tuempresa.com
# JC_ADMIN_PASSWORD=use-a-unique-long-password
JC_WHATSAPP=0
# JC_BROWSER_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

# Vercel production only (never VITE_ variables):
# DATABASE_URL is supplied by the Neon integration.
# JC_VAULT_KEY is the original vault.key encoded as base64; never generate a new key during migration.
